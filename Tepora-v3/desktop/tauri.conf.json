{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tepora V3 Beta",
  "version": "3.0.0-beta.11",
  "identifier": "dev.tepora.companion.v3",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node-runtime"
    ],
    "resources": {
      "resources/v3/": "v3/",
      "resources/licenses/": "licenses/"
    },
    "shortDescription": "Your local-first companion workspace",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
